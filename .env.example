DATABASE_URL="postgresql://sellsnap:sellsnap@db:5432/sellsnap"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
FRONTEND_URL="http://localhost"
# CORS_ORIGIN - Allowed origin for CORS requests. Rejects all origins when not set.
CORS_ORIGIN="http://localhost"
# Comma-separated trusted proxy IP addresses/CIDRs. Empty ignores forwarding headers.
TRUSTED_PROXIES=""
# API_URL - Base URL of the API server, used in webhooks for download links.
API_URL="http://localhost:3000"
POSTGRES_USER=sellsnap
POSTGRES_PASSWORD=sellsnap
POSTGRES_DB=sellsnap
# Uploads fail closed until a private clamd endpoint is configured.
CLAMAV_HOST=
CLAMAV_PORT=3310
MAX_UPLOAD_SIZE=10485760
USER_STORAGE_QUOTA_BYTES=1073741824
